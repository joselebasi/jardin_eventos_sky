---
import Image from "astro/components/Image.astro";
---

<main>
    <section class="relative h-full overflow-hidden bg-neutral-950 text-white">
        <div
            class="max-w-7xl mx-auto px-6 py-12 grid lg:grid-cols-2 gap-12 items-center"
        >
            <!-- Texto -->
            <div>
                <h1 class="text-5xl md:text-6xl font-bold leading-tight">
                    Momentos que cuentan historias
                </h1>
                <p class="mt-6 text-lg text-neutral-300">
                    El mejor lugar para tus eventos en Atlatlahucan, Mor.
                </p>

                <a
                    href="#galeria"
                    class="inline-block mt-8 px-8 py-3 bg-white text-black font-medium rounded-full hover:bg-neutral-200 transition"
                >
                    Explorar galería
                </a>
            </div>

            <!-- Preview tipo collage -->

            <div class="relative animate-fade-in-right">
                <!-- Glow -->
                <div
                    class="absolute -inset-4 bg-white/5 blur-3xl rounded-[3rem]"
                >
                </div>

                <!-- Card video -->
                <div
                    class="relative overflow-hidden rounded-[2rem] border border-neutral-800 shadow-2xl bg-neutral-900"
                >
                    <!-- Overlay -->
                    <div
                        class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent z-10 pointer-events-none"
                    >
                    </div>

                    <video
                        autoplay
                        loop
                        muted
                        playsinline
                        class="w-full h-[650px] object-cover"
                    >
                        <source src="/video2.mp4" type="video/mp4" />
                    </video>

                    <!-- Badge -->
                    <div
                        class="absolute bottom-6 left-6 z-20 backdrop-blur-md bg-black/40 border border-white/10 rounded-2xl px-5 py-4"
                    >
                        <p class="text-sm text-neutral-300">
                            Jardín de Eventos SKY
                        </p>

                        <h3 class="text-xl font-semibold mt-1">
                            Atlatlahucan, Morelos
                        </h3>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
