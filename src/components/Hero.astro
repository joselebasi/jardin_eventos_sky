---
import ActionLink from "./ActionLink";
---

<main>
    <section class="grid items-center overflow-hidden bg-background text-foreground min-[761px]:min-h-[min(48rem,calc(100svh-6.25rem))]">
        <div class="mx-auto grid w-[calc(100%-2rem)] max-w-7xl items-center gap-10 py-14 sm:w-[calc(100%-3rem)] min-[761px]:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] min-[761px]:gap-12 min-[761px]:py-16 lg:gap-20">
            <div class="relative z-1 min-w-0">
                <p class="mb-6 flex items-center gap-3 text-xs font-semibold text-primary"><span class="size-2 shrink-0 rounded-full bg-primary" aria-hidden="true"></span> Celebra en un entorno extraordinario</p>
                <h1 class="max-w-[15ch] font-display text-4xl leading-tight font-medium lg:text-5xl">Un escenario natural para celebrar <em class="text-primary not-italic">lo que importa.</em></h1>
                <p class="mt-6 max-w-lg text-lg leading-relaxed text-muted-foreground">Un jardín lleno de encanto en Atlatlahucan, Morelos, para reunir a quienes más quieres.</p>
                <div class="mt-8 flex flex-wrap items-center gap-4">
                    <ActionLink href="/contacto" label="Cotiza tu evento" />
                    <ActionLink href="/galeria" label="Descubre el jardín" variant="outline" arrow={false} />
                </div>
                <p class="mt-10 text-sm text-[var(--color-header-muted)]">Atlatlahucan <span class="px-1 text-primary" aria-hidden="true">·</span> Morelos, México</p>
            </div>
            <figure class="relative m-0 h-[58svh] max-h-136 min-h-88 min-w-0 overflow-hidden bg-accent min-[761px]:h-[min(37rem,62svh)] min-[761px]:max-h-none min-[761px]:min-h-100">
                <video class="size-full object-cover" data-lazy-video loop muted playsinline preload="none" poster="/uno.webp" aria-hidden="true" tabindex="-1"><source data-src="/video2.mp4" type="video/mp4" /></video>
                <div class="pointer-events-none absolute inset-x-0 bottom-0 h-2/3 bg-linear-to-t from-black/75 to-transparent" aria-hidden="true"></div>
                <figcaption class="absolute inset-x-4 bottom-4 z-1 flex flex-col gap-2 text-white sm:inset-x-6 sm:bottom-6 sm:flex-row sm:items-end sm:justify-between sm:gap-4">
                    <span class="font-display text-sm">Jardín de Eventos SKY</span>
                    <span class="text-xs text-white/85 sm:text-right">Un lugar para volver a celebrar</span>
                </figcaption>
            </figure>
        </div>
    </section>
</main>

<script>
    const video = document.querySelector<HTMLVideoElement>("[data-lazy-video]");
    const videoSource = video?.querySelector<HTMLSourceElement>("source[data-src]");
    if (video && videoSource && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        let sourceLoaded = false;
        const observer = new IntersectionObserver(([entry]) => {
            if (entry.isIntersecting) {
                if (!sourceLoaded) {
                    videoSource.src = videoSource.dataset.src ?? "";
                    video.load();
                    sourceLoaded = true;
                }
                void video.play().catch(() => undefined);
            } else {
                video.pause();
            }
        }, { rootMargin: "160px 0px" });
        observer.observe(video);
    }
</script>
