---
import { Mail, MapPin, Phone } from "lucide-react";
import ContactForm from "./ContactForm";
const details = [
    { icon: Phone, title: "WhatsApp / Teléfono", description: "Llámanos o envíanos un mensaje", label: "+52 735 123 4567", href: "https://wa.me/527351234567", external: true },
    { icon: Mail, title: "Correo electrónico", description: "Escríbenos para cotizaciones detalladas", label: "jardineventosky@gmail.com", href: "mailto:jardineventosky@gmail.com", external: false },
    { icon: MapPin, title: "Ubicación", description: "Atlatlahucan, Morelos, México.", label: "Ver ubicación", href: "/ubicacion", external: false },
];
---

<main class="bg-background text-foreground">
    <section class="mx-auto w-[calc(100%-2rem)] max-w-7xl py-14 sm:w-[calc(100%-3rem)] sm:py-20 lg:py-24">
        <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
            <div class="min-w-0 space-y-12">
                <div>
                    <h1 class="font-display text-3xl leading-tight font-medium sm:text-4xl lg:text-5xl">Contáctanos</h1>
                    <p class="mt-6 max-w-md text-lg leading-relaxed text-muted-foreground">Estamos listos para hacer de tu evento algo inolvidable. ¡Hablemos!</p>
                </div>
                <div class="space-y-8">
                    {details.map(({ icon: Icon, title, description, label, href, external }) => (
                        <div class="flex min-w-0 items-start gap-4">
                            <div class="shrink-0 rounded-md border border-border bg-accent p-3"><Icon className="size-6 text-muted-foreground" aria-hidden="true" /></div>
                            <div class="min-w-0">
                                <h2 class="text-lg font-semibold">{title}</h2>
                                <p class="mt-1 leading-relaxed text-muted-foreground">{description}</p>
                                <a class="mt-2 inline-block max-w-full text-sm font-medium break-words text-primary underline-offset-4 hover:underline" href={href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>{label}</a>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
            <div class="min-w-0 border-t border-border pt-8 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-10">
                <ContactForm client:load />
            </div>
        </div>
    </section>
</main>
