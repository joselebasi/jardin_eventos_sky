---
import { faFacebook } from "@fortawesome/free-brands-svg-icons";
const year = new Date().getFullYear();
const socialLinkClass = "inline-flex items-center gap-2 text-black transition-opacity hover:opacity-70 [[data-theme=dark]_&]:text-white";
---

<footer class="bg-[var(--color-forest)] text-foreground">
    <div class="mx-auto flex w-[calc(100%-2rem)] max-w-7xl flex-col gap-4 border-t border-border py-4 text-xs text-[var(--color-header-muted)] sm:w-[calc(100%-3rem)] sm:flex-row sm:items-center sm:justify-between">
        <a class="brand" href="/" aria-label="Jardín de Eventos SKY, inicio"><img class="h-17 w-29 object-contain brightness-0 [[data-theme=dark]_&]:invert" src="/logo-jardin-sky.png" alt="" width="159" height="82" /></a>
        <span>© {year} Jardín de Eventos SKY. Todos los derechos reservados. Hecho por <a class="underline decoration-transparent underline-offset-4 transition-colors hover:text-primary hover:decoration-current" href="https://www.linkedin.com/in/jose-toledano-morales/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn de Jose Toledano">Jose Toledano</a></span>
        <nav class="flex flex-wrap items-center gap-x-4 gap-y-2" aria-label="Redes sociales">
            <a class={socialLinkClass} href="https://www.facebook.com/profile.php?id=61590183835911" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                <svg class="size-4 shrink-0 fill-current" viewBox={`0 0 ${faFacebook.icon[0]} ${faFacebook.icon[1]}`} aria-hidden="true" focusable="false"><path d={faFacebook.icon[4]} /></svg>
                <span>Facebook</span>
            </a>
        </nav>
    </div>
</footer>
