---
import GalleryCarousel from "./GalleryCarousel";
---

<main class="bg-background text-foreground">
    <section class="overflow-hidden py-14 sm:py-20 lg:py-24" aria-labelledby="gallery-title">
        <div class="mx-auto w-[calc(100%-2rem)] max-w-7xl sm:w-[calc(100%-3rem)]">
            <header class="mb-6 max-w-3xl sm:mb-10">
                <p class="mb-4 text-xs font-semibold text-primary">Jardín de Eventos SKY</p>
                <h1 id="gallery-title" class="font-display text-3xl leading-tight font-medium sm:text-4xl lg:text-5xl">Un lugar para celebrar</h1>
                <p class="mt-5 max-w-xl text-base leading-relaxed text-muted-foreground">Un vistazo a los espacios donde suceden los mejores momentos.</p>
            </header>
            <GalleryCarousel client:load />
        </div>
    </section>
</main>
